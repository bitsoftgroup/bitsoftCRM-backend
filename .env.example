DATABASE_URL=postgresql://user:password@localhost:5432/bitsoftcrm
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
PORT=4000

# Only needed to run the one time Firebase export script (see scripts/exportFirebase.ts)
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_DATABASE_URL=
# Session cookie 'Secure' flag; defaults to true when NODE_ENV=production. Set false only for plain-http setups.
# COOKIE_SECURE=true
# How long the exported desktop app's login lasts (it stays signed in until the user logs out).
# DESKTOP_JWT_EXPIRES_IN=3650d

# Where published desktop UI releases are stored.
# DESKTOP_RELEASES_DIR=releases/desktop-ui
