generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  reception
  teacher
}

enum StudentStatus {
  active
  frozen
  graduated
  dropped
  pending
}

enum BalanceType {
  debt
  credit
}

enum CourseLevel {
  beginner
  intermediate
  pro
}

enum CourseStatus {
  active
  planned
}

enum PaymentMethod {
  cash
  card
  transfer
}

enum PaymentStatus {
  paid
  partial
  debt
}

enum CashCategory {
  rent
  utilities
  salary
  supplies
  other
}

/// A customer of the product: one education center. Every tenant-scoped row
/// below belongs to exactly one EducationCenter via educationCenterId.
model EducationCenter {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique
  logoUrl         String?
  contactEmail    String?
  contactPhone    String?
  ownerName       String?
  ownerPhone      String?
  ownerEmail      String?
  /// sha256 hex digest of the per-center tenant token sent as X-Tenant-Token.
  /// The plaintext token is shown once at creation/regeneration and never stored.
  tenantTokenHash String?  @unique
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  users                User[]
  students             Student[]
  teachers             Teacher[]
  courses              Course[]
  groups               Group[]
  payments             Payment[]
  attendance           Attendance[]
  contracts            Contract[]
  cashExpenses         CashExpense[]
  settings             Settings?
  contractYearCounters ContractYearCounter[]
  exportJobs           ExportJob[]
}

enum ExportJobStatus {
  pending
  building
  done
  failed
}

/// Tracks one background build of this center's branded desktop .exe.
model ExportJob {
  id                String          @id @default(uuid())
  educationCenterId String
  educationCenter   EducationCenter @relation(fields: [educationCenterId], references: [id])
  status            ExportJobStatus @default(pending)
  filePath          String?
  error             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([educationCenterId, createdAt])
}

/// Vendor-level login, unrelated to any single education center. Manages the
/// EducationCenter registry from the superadmin app.
model SuperAdmin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model User {
  id                String          @id @default(uuid())
  educationCenterId String
  educationCenter   EducationCenter @relation(fields: [educationCenterId], references: [id])
  email             String
  password          String
  role              Role
  teacherId         String?         @unique
  teacher           Teacher?        @relation(fields: [teacherId], references: [id])
  createdAt         DateTime        @default(now())

  @@unique([educationCenterId, email])
}

model Student {
  id                  String          @id @default(uuid())
  educationCenterId   String
  educationCenter     EducationCenter @relation(fields: [educationCenterId], references: [id])
  name                String
  phone               String?
  parentPhone         String?
  birthDate           DateTime?
  status              StudentStatus   @default(active)
  dueDay              Int
  interestCourseId    String?
  interestCourse      Course?         @relation(fields: [interestCourseId], references: [id])
  notes               String?
  enrolledAt          DateTime        @default(now())
  deleted             Boolean         @default(false)
  deletedAt           DateTime?
  deleteNote          String?
  deleteBalanceType   BalanceType?
  deleteBalanceAmount Decimal?        @db.Decimal(12, 2)

  groups    StudentGroup[]
  payments  Payment[]
  contracts Contract[]

  @@index([educationCenterId, name])
}

model StudentGroup {
  studentId String
  groupId   String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group     Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([studentId, groupId])
}

model Group {
  id                      String          @id @default(uuid())
  educationCenterId       String
  educationCenter         EducationCenter @relation(fields: [educationCenterId], references: [id])
  name                    String
  courseId                String
  course                  Course          @relation(fields: [courseId], references: [id])
  teacherId               String
  teacher                 Teacher         @relation(fields: [teacherId], references: [id])
  startDate               DateTime?
  endDate                 DateTime?
  maxStudents             Int?
  scheduleDays            String[]
  scheduleTime            String?
  scheduleDurationMinutes Int?
  room                    String?
  isActive                Boolean         @default(true)

  students   StudentGroup[]
  payments   Payment[]
  attendance Attendance[]
  contracts  Contract[]

  @@index([educationCenterId, name])
}

model Course {
  id                String          @id @default(uuid())
  educationCenterId String
  educationCenter   EducationCenter @relation(fields: [educationCenterId], references: [id])
  name              String
  level             CourseLevel
  price             Decimal         @db.Decimal(12, 2)
  courseStatus      CourseStatus    @default(active)
  isActive          Boolean         @default(true)

  groups             Group[]
  interestedStudents Student[]
  contracts          Contract[]

  @@index([educationCenterId, name])
}

model Teacher {
  id                String          @id @default(uuid())
  educationCenterId String
  educationCenter   EducationCenter @relation(fields: [educationCenterId], references: [id])
  name              String
  phone             String?
  isActive          Boolean         @default(true)

  groups Group[]
  user   User?

  @@index([educationCenterId, name])
}

model Payment {
  id                String          @id @default(uuid())
  educationCenterId String
  educationCenter   EducationCenter @relation(fields: [educationCenterId], references: [id])
  studentId         String
  student           Student         @relation(fields: [studentId], references: [id])
  groupId           String?
  group             Group?          @relation(fields: [groupId], references: [id])
  amount            Decimal         @db.Decimal(12, 2)
  month             String
  dueDay            Int?
  paidDate          DateTime?
  paidAt            DateTime        @default(now())
  method            PaymentMethod
  status            PaymentStatus
  discount          Decimal?        @db.Decimal(12, 2)
  originalPrice     Decimal?        @db.Decimal(12, 2)
  notes             String?
  deleted           Boolean         @default(false)

  @@index([educationCenterId, studentId, groupId, month])
}

model Attendance {
  id                String          @id @default(uuid())
  educationCenterId String
  educationCenter   EducationCenter @relation(fields: [educationCenterId], references: [id])
  groupId           String
  group             Group           @relation(fields: [groupId], references: [id])
  date              DateTime
  records           Json
  updatedAt         DateTime        @updatedAt

  @@unique([groupId, date])
}

model Contract {
  id                String          @id @default(uuid())
  educationCenterId String
  educationCenter   EducationCenter @relation(fields: [educationCenterId], references: [id])
  studentId         String
  student           Student         @relation(fields: [studentId], references: [id])
  groupId           String?
  group             Group?          @relation(fields: [groupId], references: [id])
  courseId          String
  course            Course          @relation(fields: [courseId], references: [id])
  contractNumber    String

  address      String?
  centerPhone  String?
  centerName   String?
  centerLogoUrl String?
  directorName String?
  studentName  String?
  birthDate    DateTime?
  phone        String?
  parentPhone  String?
  courseName   String?
  groupName    String?
  price        Decimal?  @db.Decimal(12, 2)
  graceDays    Int?
  startDate    DateTime?
  signDate     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([educationCenterId, contractNumber])
}

model CashExpense {
  id                String          @id @default(uuid())
  educationCenterId String
  educationCenter   EducationCenter @relation(fields: [educationCenterId], references: [id])
  category          CashCategory
  amount            Decimal         @db.Decimal(12, 2)
  date              DateTime
  note              String?
  createdAt         DateTime        @default(now())
  deleted           Boolean         @default(false)
  deletedAt         DateTime?
}

model Settings {
  educationCenterId  String          @id
  educationCenter    EducationCenter @relation(fields: [educationCenterId], references: [id])
  discounts          Json
  holidays           Json
  rooms              String[]
  contractInfo       Json
  cashOpeningBalance Decimal         @default(0) @db.Decimal(12, 2)
}

model ContractYearCounter {
  educationCenterId String
  educationCenter   EducationCenter @relation(fields: [educationCenterId], references: [id])
  year              Int
  counter           Int             @default(0)

  @@id([educationCenterId, year])
}
